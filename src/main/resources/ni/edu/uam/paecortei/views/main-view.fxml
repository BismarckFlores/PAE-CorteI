<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
    Ventana principal: encabezado + pestanas con los dos formularios.
    Para usarla, cargar "views/main-view.fxml" desde HelloApplication.
-->
<BorderPane fx:id="mainRoot" stylesheets="@../styles/styles.css" prefWidth="1000" prefHeight="640"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT">
            <StackPane styleClass="brand-badge">
                <SVGPath styleClass="brand-icon" scaleX="0.9" scaleY="0.9"
                         content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
            </StackPane>
            <VBox spacing="1">
                <Label text="Gestión de Empleados" styleClass="app-title"/>
                <Label text="Sistema de registro de personal" styleClass="app-subtitle"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabPane" styleClass="main-tabs" tabClosingPolicy="UNAVAILABLE">
            <Tab fx:id="tabForm" text="Registrar empleado">
                <graphic>
                    <SVGPath styleClass="tab-icon" scaleX="0.7" scaleY="0.7"
                             content="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </graphic>
                <fx:include fx:id="employeeForm" source="employee-form.fxml"/>
            </Tab>
            <Tab fx:id="tabList" text="Listado de empleados">
                <graphic>
                    <SVGPath styleClass="tab-icon" scaleX="0.7" scaleY="0.7"
                             content="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/>
                </graphic>
                <fx:include fx:id="employeeList" source="employee-list.fxml"/>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
